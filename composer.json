{
    "name": "fomvasss/laravel-notification-channel-gronosync",
    "description": "Laravel notification channel for GronoSync — send messages via Telegram, WhatsApp, Instagram, Facebook, Viber, SMS, email and other channels through the GronoSync platform.",
    "homepage": "https://github.com/fomvasss/laravel-notification-channel-gronosync",
    "keywords": ["laravel", "notifications", "gronosync", "telegram", "whatsapp", "chat"],
    "license": "MIT",
    "authors": [
        {
            "name": "Fomin Vasil",
            "email": "fomvasss@gmail.com",
            "homepage": "https://github.com/fomvasss",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/notifications": "^10|^11|^12|^13",
        "illuminate/support": "^10|^11|^12|^13"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\Gronosync\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\Gronosync\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text --coverage-clover=coverage.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\Gronosync\\GronosyncServiceProvider"
            ]
        }
    }
}
